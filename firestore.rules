rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =========================================================================
    // 0. GLOBAL DEFAULT-DENY SAFETY NET
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // 1. HARDENED PRIMITIVE HELPERS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isVerifiedOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // 2. ENTITY VALIDATION BLUEPRINTS (THE ANTI-UPDATE-GAP)
    // =========================================================================

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferencesJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'preferencesJson',
          'createdAt',
          'updatedAt'
        ]) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
        data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == uid &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() <= 150 &&
        data.email is string && data.email.size() <= 200 &&
        data.photoURL is string && data.photoURL.size() <= 1000 &&
        data.preferencesJson is string && data.preferencesJson.size() <= 5000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidOrganizationRecord(data, uid, organizationId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'name',
          'shortName',
          'nameDhivehi',
          'address',
          'phone',
          'email',
          'website',
          'mainLogo1Id',
          'mainLogo2Id',
          'archived',
          'configPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerUid',
          'name',
          'shortName',
          'nameDhivehi',
          'address',
          'phone',
          'email',
          'website',
          'mainLogo1Id',
          'mainLogo2Id',
          'archived',
          'configPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == organizationId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == uid &&
        data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.shortName is string && data.shortName.size() <= 100 &&
        data.nameDhivehi is string && data.nameDhivehi.size() <= 200 &&
        data.address is string && data.address.size() <= 300 &&
        data.phone is string && data.phone.size() <= 80 &&
        data.email is string && data.email.size() <= 150 &&
        data.website is string && data.website.size() <= 250 &&
        data.mainLogo1Id is string && data.mainLogo1Id.size() <= 128 &&
        data.mainLogo2Id is string && data.mainLogo2Id.size() <= 128 &&
        data.archived is bool &&
        data.configPayload is string && data.configPayload.size() <= 120000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidEventRecord(data, uid, organizationId, eventId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'organizationId',
          'title',
          'date',
          'venue',
          'archived',
          'configPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerUid',
          'organizationId',
          'title',
          'date',
          'venue',
          'archived',
          'configPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == eventId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == uid &&
        data.ownerUid == request.auth.uid &&
        data.organizationId is string && data.organizationId.size() >= 1 && data.organizationId.size() <= 128 &&
        data.organizationId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.organizationId == organizationId &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 300 &&
        data.date is string && data.date.size() <= 40 &&
        data.venue is string && data.venue.size() <= 300 &&
        data.archived is bool &&
        data.configPayload is string && data.configPayload.size() <= 250000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLogoRecord(data, uid, logoId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'name',
          'category',
          'organizationId',
          'eventId',
          'dataUrl',
          'storagePath',
          'aspectRatio',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerUid',
          'name',
          'category',
          'organizationId',
          'eventId',
          'dataUrl',
          'storagePath',
          'aspectRatio',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == logoId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == uid &&
        data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.category is string && data.category in ['organization', 'sponsor', 'participant', 'co-organizer'] &&
        data.organizationId is string && data.organizationId.size() <= 128 &&
        data.eventId is string && data.eventId.size() <= 128 &&
        data.dataUrl is string && data.dataUrl.size() <= 850000 &&
        data.storagePath is string && data.storagePath.size() <= 500 &&
        (data.aspectRatio is int || data.aspectRatio is float) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidFontRecord(data, uid, fontId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'name',
          'family',
          'isRtlOptimized',
          'dataUrl',
          'storagePath',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerUid',
          'name',
          'family',
          'isRtlOptimized',
          'dataUrl',
          'storagePath',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == fontId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == uid &&
        data.ownerUid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.family is string && data.family.size() >= 1 && data.family.size() <= 250 &&
        data.isRtlOptimized is bool &&
        data.dataUrl is string && data.dataUrl.size() <= 850000 &&
        data.storagePath is string && data.storagePath.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTemplateRecord(data, uid, templateId) {
      return data.keys().hasAll([
          'id',
          'ownerUid',
          'organizationId',
          'name',
          'description',
          'category',
          'configPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerUid',
          'organizationId',
          'name',
          'description',
          'category',
          'configPayload',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id is string && data.id.size() >= 1 && data.id.size() <= 128 &&
        data.id.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.id == templateId &&
        data.ownerUid is string && data.ownerUid.size() >= 1 && data.ownerUid.size() <= 128 &&
        data.ownerUid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid == uid &&
        data.ownerUid == request.auth.uid &&
        data.organizationId is string && data.organizationId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 200 &&
        data.description is string && data.description.size() <= 500 &&
        data.category is string && data.category in ['banner', 'color-grade', 'full-event'] &&
        data.configPayload is string && data.configPayload.size() <= 200000 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // =========================================================================
    // 3. COLLECTION MATCH BLOCKS (PII ISOLATED & OWNER-SCOPED)
    // =========================================================================

    match /users/{uid} {
      allow get: if isOwner(uid) && isValidId(uid) && (resource == null || existing().uid == request.auth.uid);
      allow list: if isOwner(uid) && existing().uid == request.auth.uid;
      allow create: if isVerifiedOwner(uid) &&
        isValidId(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedOwner(uid) &&
        isValidId(uid) &&
        isValidUserProfile(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'preferencesJson',
          'updatedAt'
        ]);
      allow delete: if false;

      // 3.1 Organizations Subcollection
      match /organizations/{organizationId} {
        allow get: if isOwner(uid) &&
          isValidId(uid) &&
          isValidId(organizationId) &&
          (resource == null || existing().ownerUid == request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) &&
          existing().ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(organizationId) &&
          isValidOrganizationRecord(incoming(), uid, organizationId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(organizationId) &&
          isValidOrganizationRecord(incoming(), uid, organizationId) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'shortName',
            'nameDhivehi',
            'address',
            'phone',
            'email',
            'website',
            'mainLogo1Id',
            'mainLogo2Id',
            'archived',
            'configPayload',
            'updatedAt'
          ]) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(organizationId) &&
          existing().ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;

        // 3.2 Events Subcollection under Organization
        match /events/{eventId} {
          allow get: if isOwner(uid) &&
            isValidId(uid) &&
            isValidId(organizationId) &&
            isValidId(eventId) &&
            (resource == null || (existing().ownerUid == request.auth.uid && existing().organizationId == organizationId)) &&
            get(/databases/$(database)/documents/users/$(uid)/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
          allow list: if isOwner(uid) &&
            existing().ownerUid == request.auth.uid &&
            existing().organizationId == organizationId;
          allow create: if isVerifiedOwner(uid) &&
            isValidId(uid) &&
            isValidId(organizationId) &&
            isValidId(eventId) &&
            isValidEventRecord(incoming(), uid, organizationId, eventId) &&
            incoming().createdAt == request.time &&
            incoming().updatedAt == request.time &&
            get(/databases/$(database)/documents/users/$(uid)/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
          allow update: if isVerifiedOwner(uid) &&
            isValidId(uid) &&
            isValidId(organizationId) &&
            isValidId(eventId) &&
            isValidEventRecord(incoming(), uid, organizationId, eventId) &&
            incoming().id == existing().id &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().organizationId == existing().organizationId &&
            incoming().createdAt == existing().createdAt &&
            incoming().updatedAt == request.time &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title',
              'date',
              'venue',
              'archived',
              'configPayload',
              'updatedAt'
            ]) &&
            get(/databases/$(database)/documents/users/$(uid)/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
          allow delete: if isVerifiedOwner(uid) &&
            isValidId(uid) &&
            isValidId(organizationId) &&
            isValidId(eventId) &&
            existing().ownerUid == request.auth.uid &&
            get(/databases/$(database)/documents/users/$(uid)/organizations/$(organizationId)).data.ownerUid == request.auth.uid;
        }
      }

      // 3.3 Reusable Logos Subcollection
      match /logos/{logoId} {
        allow get: if isOwner(uid) &&
          isValidId(uid) &&
          isValidId(logoId) &&
          (resource == null || existing().ownerUid == request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) &&
          existing().ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(logoId) &&
          isValidLogoRecord(incoming(), uid, logoId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(logoId) &&
          isValidLogoRecord(incoming(), uid, logoId) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'category',
            'organizationId',
            'eventId',
            'dataUrl',
            'storagePath',
            'aspectRatio',
            'updatedAt'
          ]) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(logoId) &&
          existing().ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
      }

      // 3.4 Reusable Custom & Dhivehi Fonts Subcollection
      match /fonts/{fontId} {
        allow get: if isOwner(uid) &&
          isValidId(uid) &&
          isValidId(fontId) &&
          (resource == null || existing().ownerUid == request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) &&
          existing().ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(fontId) &&
          isValidFontRecord(incoming(), uid, fontId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(fontId) &&
          isValidFontRecord(incoming(), uid, fontId) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name',
            'family',
            'isRtlOptimized',
            'dataUrl',
            'storagePath',
            'updatedAt'
          ]) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(fontId) &&
          existing().ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
      }

      // 3.5 Saved Event & Banner Templates Subcollection
      match /templates/{templateId} {
        allow get: if isOwner(uid) &&
          isValidId(uid) &&
          isValidId(templateId) &&
          (resource == null || existing().ownerUid == request.auth.uid) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow list: if isOwner(uid) &&
          existing().ownerUid == request.auth.uid;
        allow create: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(templateId) &&
          isValidTemplateRecord(incoming(), uid, templateId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow update: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(templateId) &&
          isValidTemplateRecord(incoming(), uid, templateId) &&
          incoming().id == existing().id &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'organizationId',
            'name',
            'description',
            'category',
            'configPayload',
            'updatedAt'
          ]) &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
        allow delete: if isVerifiedOwner(uid) &&
          isValidId(uid) &&
          isValidId(templateId) &&
          existing().ownerUid == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(uid)).data.uid == request.auth.uid;
      }
    }
  }
}
