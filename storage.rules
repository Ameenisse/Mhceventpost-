rules_version = '2';

// Firebase Cloud Storage Security Rules for Event Photo Branding Studio
// STRICTLY restricts reusable branding logos and custom font files to their owning user UID.
// Event photographs are NEVER uploaded or stored in Cloud Storage.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/logos/{logoId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        request.resource.size < 2 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/fonts/{fontId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null &&
        request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        request.resource.size < 5 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
